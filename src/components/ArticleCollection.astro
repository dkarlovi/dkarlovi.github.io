---
import type { Page } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleCard from './ArticleCard.astro';
import CategorySidebar from './CategorySidebar.astro';
import Pagination from './Pagination.astro';
interface Props { page: Page<CollectionEntry<'articles'>>; intro: CollectionEntry<'pages'> | CollectionEntry<'categories'> | CollectionEntry<'series'>; parentTitle?: string }
const { page, intro, parentTitle } = Astro.props;
const { Content } = await render(intro);
---
<SiteLayout {...intro.data} title={parentTitle ? `${intro.data.title} - ${parentTitle}` : intro.data.title}><section class="collection-heading">{parentTitle && <p class="eyebrow">{parentTitle}</p>}<h1>{parentTitle ? <>Articles in {intro.data.title}</> : intro.data.title}</h1><div class="content"><Content /></div></section><div class="listing-layout"><section aria-label="Articles">{page.data.length ? <div class="article-grid">{page.data.map((article,i)=><ArticleCard article={article} priority={i===0} loading={i<2?'eager':'lazy'} />)}</div>:<p class="empty-state">No articles found here.</p>}<Pagination page={page} /></section><CategorySidebar /></div></SiteLayout>
