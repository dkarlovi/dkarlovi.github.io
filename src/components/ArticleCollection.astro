---
import type { Page } from 'astro';
import { type CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleCard from './ArticleCard.astro';
import CategorySidebar from './CategorySidebar.astro';
import Pagination from './Pagination.astro';
import CollectionHeading from './CollectionHeading.astro';
import { imagePalette } from '../lib/image-palette';
import { paletteStyle } from '../lib/palette';
interface Props { page: Page<CollectionEntry<'articles'>>; intro: CollectionEntry<'pages'> | CollectionEntry<'categories'> | CollectionEntry<'series'>; parentTitle?: string }
const { page, intro, parentTitle } = Astro.props;
const palette = await imagePalette(intro.data.image?.url);
const showCategorySidebar = intro.collection !== 'series';
---
<SiteLayout {...intro.data} pageClass={intro.data.image ? 'has-hero' : ''} palette={paletteStyle(palette)} title={parentTitle ? `${intro.data.title} - ${parentTitle}` : intro.data.title}><CollectionHeading intro={intro} palette={palette} eyebrow={parentTitle} title={parentTitle ? `Articles in ${intro.data.title}` : intro.data.title} /><div class:list={['listing-layout', { 'without-sidebar': !showCategorySidebar }]}><section aria-label="Articles">{page.data.length ? <div class="article-grid">{page.data.map((article,i)=><ArticleCard article={article} priority={i===0} loading={i<2?'eager':'lazy'} />)}</div>:<p class="empty-state">No articles found here.</p>}<Pagination page={page} /></section>{showCategorySidebar && <CategorySidebar />}</div></SiteLayout>
