---
import { getEntry, type CollectionEntry } from 'astro:content';
import SocialIcon from './SocialIcon.astro';
interface Props { article: CollectionEntry<'articles'> }
const { article: { data } } = Astro.props;
const archive = (await getEntry('pages', 'article-collection'))!;
---
{(data.discussReddit || data.discussHackerNews) && <nav class="discussion-links" aria-label="Discuss this article">
    {archive.data.discussionHeading && <span class="eyebrow">{archive.data.discussionHeading}</span>}
    <ul class="social-links flex flex-wrap gap-2">
        {data.discussReddit && <li><a class="icon-link" data-brand="reddit" href={`https://www.reddit.com/comments/${data.discussReddit}/`} target="_blank" rel="noopener noreferrer" aria-label="Discuss on Reddit" title="Discuss on Reddit"><SocialIcon name="reddit" /></a></li>}
        {data.discussHackerNews && <li><a class="icon-link" data-brand="hacker-news" href={`https://news.ycombinator.com/item?id=${data.discussHackerNews}`} target="_blank" rel="noopener noreferrer" aria-label="Discuss on Hacker News" title="Discuss on Hacker News"><SocialIcon name="hacker-news" /></a></li>}
    </ul>
</nav>}
