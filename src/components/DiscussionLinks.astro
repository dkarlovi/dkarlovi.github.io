---
import type { CollectionEntry } from 'astro:content';
interface Props { article: CollectionEntry<'articles'> }
const { article: { data } } = Astro.props;
---
{(data.discussReddit || data.discussHackerNews) && <nav class="discussion-links flex flex-wrap items-center gap-5" aria-label="Discuss this article"><span class="eyebrow">Continue the conversation</span>{data.discussReddit && <a class="text-link" href={`https://www.reddit.com/comments/${data.discussReddit}/`} target="_blank" rel="noopener noreferrer">Reddit <span aria-hidden="true">↗</span></a>}{data.discussHackerNews && <a class="text-link" href={`https://news.ycombinator.com/item?id=${data.discussHackerNews}`} target="_blank" rel="noopener noreferrer">Hacker News <span aria-hidden="true">↗</span></a>}</nav>}
