---
import DestinationLink from './DestinationLink.astro';
import { getCollection } from 'astro:content';
import { getArticles } from '../lib/articles';
import { sitePath } from '../lib/urls';
const categories = await getCollection('categories');
const articles = await getArticles();
const current = Astro.url.pathname.replace(/\/+$/, '');
const categoryState = (id: string) => {
    const path = sitePath(`/category/${id}`);
    return current === path ? 'page' : current.startsWith(path + '/') ? 'location' : undefined;
};
---
<aside class="category-widget"><h2>Browse by subject</h2><ul role="list">{categories.sort((a,b) => a.data.title.localeCompare(b.data.title)).map(category => <li><DestinationLink class="button-link subject-link" aria-current={categoryState(category.id)} href={sitePath(`/category/${category.id}`)}><span>{category.data.title}</span><span>{articles.filter(article => article.data.categories.some(ref => ref.id === category.id)).length}</span></DestinationLink></li>)}</ul></aside>
