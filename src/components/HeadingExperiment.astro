---
/**
 * Renders an article's co-located experiment inside the layout chosen in frontmatter.
 * Layouts own the frame (size, ratio, border, palette); experiments only fill it.
 * Each experiment receives the article and its resolved palette as props.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { CollectionEntry } from 'astro:content';
import type { ArticlePalette } from '../lib/palette';
import BoxLayout from './experiments/BoxLayout.astro';
interface Props { article: CollectionEntry<'articles'>; palette: ArticlePalette; experiment: AstroComponentFactory }
const { article, palette, experiment: Experiment } = Astro.props;
const layouts = { box: BoxLayout };
const Layout = layouts[article.data.experience.layout];
---
<Layout aspect={article.data.experience.aspect}><Experiment article={article} palette={palette} /></Layout>
