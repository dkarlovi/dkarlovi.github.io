---
import DestinationLink from './DestinationLink.astro';
import { sitePath } from '../lib/urls';
import { getEntry } from 'astro:content';
const home = (await getEntry('pages', 'home'))!;
---
<DestinationLink appearance="identity" class="brand" href={sitePath('/')} aria-label={`${home.data.title} — home`}><span class="brand-mark" aria-hidden="true">dk</span><span><span class="identity-name">{home.data.title}</span>{home.data.brandTagline && <small>{home.data.brandTagline}</small>}</span></DestinationLink>
