---
import { sitePath } from '../lib/urls';
import { getEntry } from 'astro:content';
const home = (await getEntry('pages', 'home'))!;
---
<a class="brand" href={sitePath('/')} aria-label="Dalibor Karlović — home"><span class="brand-mark" aria-hidden="true">dk</span><span>Dalibor Karlović{home.data.brandTagline && <small>{home.data.brandTagline}</small>}</span></a>
