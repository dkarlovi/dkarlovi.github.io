---
import type { CollectionEntry } from 'astro:content';
import AuthorLink from './AuthorLink.astro';
interface Props { article: CollectionEntry<'articles'>; loading?: 'eager' | 'lazy'; prominent?: boolean }
const { article, loading = 'lazy', prominent = false } = Astro.props;
const date = article.data.publishedAt.toISOString().slice(0, 10);
const minutes = Math.max(1, Math.ceil((article.body ?? '').split(/\s+/).length / 220));
---
<ul class:list={['card-meta', { 'hero-author': prominent }]}>
<li><AuthorLink loading={loading} size={prominent ? 44 : 36} minutes={prominent ? minutes : undefined} /></li>
<li class="article-date"><time class="date-container" datetime={date} title={date}>{date}</time></li>
</ul>
