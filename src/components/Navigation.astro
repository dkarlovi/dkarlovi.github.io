---
import { navigation } from '../data/site';
import { sitePath } from '../lib/urls';
interface Props { id: string }
const { id } = Astro.props;
const current = Astro.url.pathname;
---
<ul class="navbar-nav my-4 my-lg-0 me-3">
  {navigation.map(item => <li class:list={['nav-item', { dropdown: item.children, active: current === sitePath(item.path) }]}>
    {item.children ? <>
      <button class="nav-link dropdown-toggle" id={`${id}-articles`} data-bs-toggle="dropdown" aria-expanded="false">{item.title}</button>
      <ul class="dropdown-menu" aria-labelledby={`${id}-articles`}>
        <li><a class="dropdown-item" href={sitePath(item.path)}>All articles</a></li>
        {item.children.map(child => <li><a class="dropdown-item" href={sitePath(child.path)}>{child.title}</a></li>)}
      </ul>
    </> : <a class="nav-link" href={sitePath(item.path)} aria-current={current === sitePath(item.path) ? 'page' : undefined}>{item.title}</a>}
  </li>)}
</ul>
