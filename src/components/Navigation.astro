---
import { sitePath } from '../lib/urls';
const current = Astro.url.pathname;
const links = [{title:'Writing',path:'/articles'},{title:'Categories',path:'/categories'},{title:'Series',path:'/series-collection'},{title:'About',path:'/about'}];
---
<nav class="site-nav" aria-label="Main navigation"><ul class="flex flex-wrap items-center gap-x-6 gap-y-3">{links.map(link => <li><a href={sitePath(link.path)} aria-current={current === sitePath(link.path) ? 'page' : undefined}>{link.title}</a></li>)}<li><a href="https://github.com/dkarlovi">GitHub <span aria-hidden="true">↗</span></a></li></ul></nav>
