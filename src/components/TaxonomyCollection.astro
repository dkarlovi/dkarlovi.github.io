---
import { Image } from 'astro:assets';
import type { Page } from 'astro';
import { render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PhotoPalette from './PhotoPalette.astro';
import Pagination from './Pagination.astro';
import { getArticles } from '../lib/articles';
import { imagePalette } from '../lib/image-palette';
import { paletteStyle } from '../lib/palette';
import { sitePath } from '../lib/urls';
interface Props { page: Page<CollectionEntry<'categories'> | CollectionEntry<'series'>>; intro: CollectionEntry<'pages'>; kind: 'categories' | 'series' }
const { page, intro, kind } = Astro.props;
const { Content } = await render(intro);
const articles = await getArticles();
const palette = await imagePalette(intro.data.image);
---
<SiteLayout {...intro.data} pageClass={intro.data.image?'has-hero':''} palette={paletteStyle(palette)}><section class={intro.data.image?'collection-hero':'collection-heading'}>{intro.data.image&&<figure class="collection-cover"><Image src={intro.data.image} width={1920} alt={intro.data.title} loading="eager" fetchpriority="high" /><PhotoPalette palette={palette} credit="Photograph by Dalibor Karlović" /></figure>}<div><p class="eyebrow">Explore the writing</p><h1>{intro.data.title}</h1><div class="content"><Content /></div></div></section><section class="page-section"><div class="taxonomy-grid">{page.data.map(item=><a class="button-link taxonomy-card" href={sitePath(`/${kind==='categories'?'category':'series'}/${item.id}`)}><span>{item.data.title} ({articles.filter(article=>article.data[kind].some(ref=>ref.id===item.id)).length})</span><span aria-hidden="true">↗</span></a>)}</div><Pagination page={page} /></section></SiteLayout>
