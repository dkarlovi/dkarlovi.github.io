---
import DestinationLink from './DestinationLink.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import CategoryBadges from './CategoryBadges.astro';
import { sitePath } from '../lib/urls';
interface Props { article: CollectionEntry<'articles'>; priority?: boolean; loading?: 'eager' | 'lazy' }
const { article, priority = false, loading = priority ? 'eager' : 'lazy' } = Astro.props;
const href = sitePath(`/${article.data.slug ?? article.id}`);
const date = article.data.publishedAt.toISOString().slice(0,10);
---
<article class="card">
<DestinationLink href={href} aria-label={article.data.title}>{article.data.image ? <Image src={article.data.image.url} width={720} height={460} fit="cover" class="article-card-image" style={article.data.image.position ? `object-position:${article.data.image.position}` : undefined} alt={article.data.image.alt ?? article.data.title} loading={loading} fetchpriority={priority ? 'high' : undefined} /> : <div class="article-card-placeholder" aria-hidden="true">Aa↗</div>}</DestinationLink>
<CategoryBadges references={article.data.categories} /><h3><DestinationLink href={href}>{article.data.title}</DestinationLink></h3><time class="meta date-container" datetime={date} title={date}>{date}</time><p class="card-text">{article.data.summary}</p><DestinationLink href={href} class="button-link read-more">Just read it! <span class="sr-only">about {article.data.title}</span><span aria-hidden="true" class="arrow">↗</span></DestinationLink>
</article>
