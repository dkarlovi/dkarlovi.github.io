---
import { socials } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---
<ul class="social-links flex flex-wrap gap-2" aria-label="Social profiles">{socials.map(link => <li><a class="icon-link" data-brand={link.icon} href={link.url} aria-label={link.title} title={link.title}><SocialIcon name={link.icon} /></a></li>)}</ul>
