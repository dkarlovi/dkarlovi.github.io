---
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import portrait from '../assets/uploads/self.jpeg';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sitePath } from '../lib/urls';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '../styles/global.css';
import '../styles/article.css';
import 'vanilla-cookieconsent/dist/cookieconsent.css';
interface Props { title?: string; summary?: string; image?: ImageMetadata; keywords?: string[]; pageClass?: string; palette?: string; stylesheet?: string; articleId?: string }
const home = (await getEntry('pages', 'home'))!;
const { title = home.data.title, summary = home.data.summary, image = home.data.image ?? portrait, keywords = [], pageClass = '', palette, stylesheet, articleId } = Astro.props;
const fullTitle = title === home.data.title ? title : `${title} - ${home.data.title}`;
const canonical = new URL(Astro.url.pathname.endsWith('/404') ? sitePath('/404.html') : Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: image, width: 1200, height: 600, fit: 'cover' });
const socialImage = new URL(ogImage.src, Astro.site);
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light dark" />
<title>{fullTitle}</title><meta name="title" content={fullTitle} /><meta name="description" content={summary} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonical} /><meta property="og:type" content={pageClass.includes('article-page') ? 'article' : 'website'} /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={summary} /><meta property="og:image" content={socialImage} /><meta property="og:url" content={canonical} />
<meta name="google-site-verification" content="soyKXJT1zDtOEO_En0NAjPTu58_HXX5stvmF5MnVrEA" />
<link rel="apple-touch-icon" sizes="180x180" href={sitePath('/apple-touch-icon.png')} /><link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
<link rel="icon" type="image/png" sizes="32x32" href={sitePath('/favicon-32x32.png')} /><link rel="manifest" href={sitePath('/site.webmanifest')} />
<meta name="theme-color" content="#f7eddd" /><link rel="sitemap" href={sitePath('/sitemap-index.xml')} />
{stylesheet && <link rel="stylesheet" href={stylesheet} />}
</head><body class={pageClass} style={palette} data-article={articleId}>
<a class="skip-link" href="#main">Skip to content</a><SiteHeader /><main id="main"><slot /></main><SiteFooter />
<script>import '../scripts/app';</script>
<script is:inline type="text/plain" data-category="analytics" data-src="https://www.googletagmanager.com/gtag/js?id=G-ZYF0F5VGJR" async></script>
<script is:inline type="text/plain" data-category="analytics">window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', 'G-ZYF0F5VGJR');</script>
</body></html>
