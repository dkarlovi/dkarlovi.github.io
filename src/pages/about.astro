---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
const page = (await getEntry('pages','about'))!;
const { Content } = await render(page);
---
<SiteLayout {...page.data} pageClass="about-page"><section class="page-section"><p class="eyebrow">A little about me</p><h1>{page.data.title}</h1>{page.data.image&&<Image src={page.data.image} width={1600} height={1000} fit="cover" class="about-portrait" alt="Dalibor Karlović" loading="eager" fetchpriority="high" />}<div class="content simple-content"><Content /><SocialLinks /></div></section></SiteLayout>
