---
import DestinationLink from '../components/DestinationLink.astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles';
import { sitePath } from '../lib/urls';
const home = (await getEntry('pages', 'home'))!;
const about = (await getEntry('pages', 'about'))!;
const archive = (await getEntry('pages', 'article-collection'))!;
const hero = about.data.homepageHero;
const articles = (await getArticles()).slice(0,4);
const portrait = home.data.image ?? about.data.image;
const aboutTeaser = about.data.homepageTeaser;
const { hero: heroCopy, ticker, writing, gallery } = home.data;
---
<SiteLayout pageClass={`home-page ${portrait ? '' : 'without-portrait'}`}>
<section class="home-hero"><div class="home-hero-copy">{hero && <span class="eyebrow">{hero.roles}</span>}<h1>{heroCopy?.firstLine ?? home.data.title}{heroCopy && <><br /><em>{heroCopy.secondLine}</em></>}</h1>{hero && <div class="home-introduction"><p>{hero.introduction}</p></div>}{(archive.data.linkLabel || about.data.linkLabel) && <div class="home-actions">{archive.data.linkLabel && <DestinationLink class="button-link" href="#writing">{archive.data.linkLabel} <span class="arrow" aria-hidden="true">↗</span></DestinationLink>}{about.data.linkLabel && <DestinationLink class="button-link secondary" href={sitePath('/about')}>{about.data.linkLabel} <span aria-hidden="true">↗</span></DestinationLink>}</div>}</div>{portrait && <div class="home-photo"><Image src={portrait.url} width={1920} alt={portrait.alt ?? home.data.title} style={portrait.position ? `object-position:${portrait.position}` : undefined} loading="eager" fetchpriority="high" /></div>}{heroCopy && <span class="hero-footnote">{heroCopy.footnote}</span>}</section>
{ticker.length > 0 && <div class="ticker">{ticker.map(text => <span>{text}</span>)}</div>}
<section class="home-writing wrap" id="writing">{writing && <div class="section-heading"><h2>{writing.title}</h2><DestinationLink class="button-link" href={sitePath('/articles')}>{archive.data.title} <span class="arrow" aria-hidden="true">↗</span></DestinationLink></div>}<div class="article-grid">{articles.map((article,i) => <ArticleCard article={article} loading={i<2?'eager':'lazy'} />)}</div></section>
{gallery && <section class="visuals-section" id="visuals"><div class="section-heading"><h2>{gallery.title}</h2><span class="eyebrow muted">{gallery.credit}</span></div><div class="visuals-grid">{gallery.photos.map(photo => <figure><Image src={photo.image.url} width={1200} height={800} alt={photo.image.alt ?? ''} style={photo.image.position ? `object-position:${photo.image.position}` : undefined} loading="lazy" /><figcaption>{photo.caption}{photo.image.credit && <span class="block">{photo.image.credit}</span>}</figcaption></figure>)}</div></section>}
{aboutTeaser && <section class="about-note" id="about">{about.data.image && <Image src={about.data.image.url} width={100} height={100} fit="cover" style={about.data.image.position ? `object-position:${about.data.image.position}` : undefined} alt="" loading="lazy" />}<div>{about.data.eyebrow && <p class="eyebrow">{about.data.eyebrow}</p>}<h2>{aboutTeaser.title}</h2><p class="about-note-summary">{aboutTeaser.summary}</p></div>{about.data.linkLabel && <DestinationLink class="button-link" href={sitePath('/about')}>{about.data.linkLabel} <span class="arrow" aria-hidden="true">↗</span></DestinationLink>}</section>}
</SiteLayout>
