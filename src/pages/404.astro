---
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/urls';
import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'not-found'))!;
---
<SiteLayout {...page.data}><section class="error-page page-section"><p class="eyebrow">{page.data.eyebrow}</p><h1>{page.data.heading ?? page.data.title}</h1><p>{page.data.summary}</p><a class="text-link" href={sitePath('/')}>{page.data.linkLabel} <span class="arrow" aria-hidden="true">↗</span></a></section></SiteLayout>
