// Always dark: the box layout frames experiments with the dark palette roles over the hero.
import type { ArticlePalette } from '../../../../src/lib/palette';
interface Props { palette: ArticlePalette }
const { palette } = Astro.props;
const tune = 'RFBTTgECABJGbHkgbWUgdG8gdGhlIG1vb27AhAEAAAAAAMBbQAQJABs5rzGxRptNQCDLRqfjjllAACABAOADeS95V6HJVkABiwTAAuC0-y919VZAAcAC6gE0KJxAqJ5WQAHqAasC3VzhuFscVkABlgO1Axr3u26ku1VAAdUDqwPz50GBZyNVQAGABMADdaztr3vAVUAB6wPgA0xoym-SIVZAAZUEoAQl9GrScxlXQAGgBIABYrNrs9WGVkAFgAHVBmowKiqvwFZAWgH1B8ABZ9GMrR4hVkAB4AGgAgiAKl0TulVAAesCdeibVJdKYVVAAXXrASWyqCgoIlVAAeAClgVASAJabr9UQAHgEusDJxv_AqwBVkABiwTAAugJaxAaCFZAAcAC9QHye8038ZFVQAH1AZYBSkA3qU4vVUABlgGqAe89jrQqIVVAAdUBlQN5hjcrLNZUQAHrA7UDBr22rQVAVEAB4AOqA6hrfoWFBVVAAaAEwAPqXjJQEUpVQAGVBNUFYvEfDmcjVkAB4AarA6D7lgitx1VAAZUEqwLsHlA-mr5VQAHLAusB6Px-C0ApVUAB6wGqAlSh_AxT1FRAAYAD6gLjTIrM3GpUQAHABVVuYkHihuRTQA';
/** Diapason's packed theme: version, presence mask, then RGB per seed (see its README). */
function packTheme(seeds: string[]): string {
    // Light primary + neutral, dark primary + neutral: mask bits 0, 1, 3, 4.
    const bytes = [1, 0b11011, ...seeds.flatMap(hex => [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16)))];
    return Buffer.from(bytes).toString('base64url');
}
const theme = packTheme([palette.light.accent, palette.light.paper, palette.dark.accent, palette.dark.paper]);
const src = `https://dkarlovi.github.io/diapason/tune?embed=1&scheme=dark&theme=${theme}#tune=${tune}`;
---
<iframe src={src} title="“Fly me to the moon”, whistled and turned into MIDI in Diapason" loading="eager"></iframe>
