---
// Terrain study: fills the heading layout's frame. Styles live in ./experiment.css.
---
<figure class="terrain" data-terrain>
    <canvas role="img" aria-label="A terrain study with an adjustable sun. Use the light position slider to change the illumination.">An abstract landscape with an adjustable light source.</canvas>
    <div class="topbar"><span class="eyebrow">A study in light</span><button type="button" data-experiment-motion aria-pressed="false">Pause</button></div>
    <figcaption><label>Light <input data-experiment-light type="range" min="0" max="100" value="68" aria-label="Light position" /></label><span>Move the light. Find the atmosphere.</span></figcaption>
</figure>
<script>import './terrain.js';</script>
